CREATE TABLE drink_log (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    drink_type TEXT NOT NULL,
    volume_ml INTEGER NOT NULL,
    hydration_ml INTEGER NOT NULL,
    created_at_epoch_millis INTEGER NOT NULL
);

selectFromPeriod:
SELECT *
FROM drink_log
WHERE created_at_epoch_millis >= :startEpochMillis
  AND created_at_epoch_millis < :endEpochMillis
ORDER BY created_at_epoch_millis DESC, id DESC;

selectHydrationTotalFromPeriod:
SELECT COALESCE(SUM(hydration_ml), 0)
FROM drink_log
WHERE created_at_epoch_millis >= :startEpochMillis
  AND created_at_epoch_millis < :endEpochMillis;

insert:
INSERT INTO drink_log(
    drink_type,
    volume_ml,
    hydration_ml,
    created_at_epoch_millis
)
VALUES (?, ?, ?, ?);

deleteById:
DELETE FROM drink_log
WHERE id = :id;

CREATE TABLE reminder_settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    enabled INTEGER NOT NULL,
    interval_minutes INTEGER NOT NULL
);

selectReminderSettings:
SELECT enabled, interval_minutes
FROM reminder_settings
WHERE id = 1;

upsertReminderSettings:
INSERT OR REPLACE INTO reminder_settings(
    id,
    enabled,
    interval_minutes
)
VALUES (1, ?, ?);
